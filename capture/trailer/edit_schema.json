{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "GENERATED by scripts/gen_trailer.py from spec/trailer.v1.json — DO NOT EDIT. Handed to `claude -p --json-schema` by capture/trailer/direct.py.",
  "title": "CutEdit",
  "description": "A change to a project's trailer, asked for in the owner's own words. Return the whole cut with only what the note asked for changed, and one change per difference. Every number on screen must be one the project gave, written the same way; words the owner typed may be used as they typed them. When the note needs something a cut cannot do (new screens, a different app), set refusal and no cut. Plain words, no dashes.",
  "type": "object",
  "properties": {
    "cut": {
      "description": "The whole new cut, when the note asked for something the cut can do. Everything the note did not ask about stays exactly as it was.",
      "anyOf": [
        {
          "$ref": "#/$defs/Cut"
        },
        {
          "type": "null"
        }
      ]
    },
    "changes": {
      "description": "Every difference between the old cut and the new one, one per thing changed. (max 12 items)",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Change"
      },
      "maxItems": 12
    },
    "refusal": {
      "description": "Set instead of a cut when the note cannot be done by changing the cut.",
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "not_understood",
            "no_model",
            "invented_number",
            "names_a_repository",
            "needs_new_capture",
            "over_limit",
            "nothing_to_change",
            "no_such_version",
            "render_failed",
            "no_trailer",
            "no_node",
            "no_demo"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "changes"
  ],
  "additionalProperties": false,
  "$defs": {
    "Cut": {
      "type": "object",
      "properties": {
        "version": {
          "description": "1-1000 1 for the first cut, one more for every change after it.",
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "seconds": {
          "description": "How long the whole trailer runs, within `seconds` min and max. The scenes share it by their weight.",
          "type": "number"
        },
        "pace": {
          "description": "How quickly things move inside a scene, within `pace` min and max. 1 is the app's own springs.",
          "type": "number"
        },
        "hue": {
          "description": "The project's colour: the band, the ink, the end card.",
          "type": "string",
          "enum": [
            "amber",
            "brass",
            "tide",
            "cobalt",
            "iris",
            "heather",
            "orchid",
            "coral",
            "ember"
          ]
        },
        "creature": {
          "description": "The creature printed on the opening band and the end card.",
          "type": "string",
          "enum": [
            "bit",
            "cat",
            "dog",
            "fox",
            "owl",
            "bee",
            "whale",
            "octopus",
            "crab"
          ]
        },
        "mood": {
          "description": "The score under it, or none.",
          "type": "string",
          "enum": [
            "quiet",
            "drive",
            "none"
          ]
        },
        "transition": {
          "description": "How one scene gives way to the next.",
          "type": "string",
          "enum": [
            "fluid",
            "morph",
            "cut"
          ]
        },
        "title": {
          "description": "The project's name on the opening band and the end card.",
          "$ref": "#/$defs/Text"
        },
        "line": {
          "description": "One line under the title: what the project is, in a few words.",
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ]
        },
        "cta": {
          "description": "The last card's line: where to get it.",
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ]
        },
        "scenes": {
          "description": "The scenes in order. The first is always open and the last always end. (2 to 10 items)",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Scene"
          },
          "maxItems": 10,
          "minItems": 2
        }
      },
      "required": [
        "version",
        "seconds",
        "pace",
        "hue",
        "creature",
        "mood",
        "transition",
        "title",
        "scenes"
      ],
      "additionalProperties": false
    },
    "Change": {
      "type": "object",
      "properties": {
        "code": {
          "description": "What changed.",
          "type": "string",
          "enum": [
            "seconds",
            "pace",
            "hue",
            "title",
            "line",
            "cta",
            "creature",
            "mood",
            "camera",
            "transition",
            "scene_added",
            "scene_removed",
            "scene_moved",
            "figure",
            "screens",
            "first",
            "reverted",
            "rerendered"
          ]
        },
        "before": {
          "description": "The value before, as its code or number. (max 90 chars)",
          "anyOf": [
            {
              "type": "string",
              "maxLength": 90
            },
            {
              "type": "null"
            }
          ]
        },
        "after": {
          "description": "The value after, as its code or number. (max 90 chars)",
          "anyOf": [
            {
              "type": "string",
              "maxLength": 90
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "code"
      ],
      "additionalProperties": false
    },
    "Text": {
      "type": "object",
      "properties": {
        "text": {
          "description": "The words as they are drawn. No dash of any kind. (max 90 chars)",
          "type": "string",
          "maxLength": 90
        },
        "source": {
          "description": "facts: from the project; person: typed by its owner; model: written by claude from the facts.",
          "type": "string",
          "enum": [
            "facts",
            "person",
            "model"
          ]
        }
      },
      "required": [
        "text",
        "source"
      ],
      "additionalProperties": false
    },
    "Scene": {
      "type": "object",
      "properties": {
        "kind": {
          "description": "What the scene shows.",
          "type": "string",
          "enum": [
            "open",
            "screens",
            "figure",
            "days",
            "changelog",
            "stack",
            "end"
          ]
        },
        "weight": {
          "description": "Its share of the trailer's seconds against the other scenes' weights, within `weight` min and max.",
          "type": "number"
        },
        "arrival": {
          "description": "How its pixels arrive: one of the app's eight orders.",
          "type": "string",
          "enum": [
            "rain",
            "scan",
            "ripple",
            "rise",
            "interlace",
            "blocks",
            "spiral",
            "wipe"
          ]
        },
        "figure": {
          "description": "figure scenes only: which number.",
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "commits",
                "sessions",
                "hours",
                "lines_added",
                "days_built",
                "streak_days"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "beats": {
          "description": "screens scenes only: which of the demo's beats (or stills) it shows, by position from 0, in order. (max 8 items)",
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "integer"
              },
              "maxItems": 8
            },
            {
              "type": "null"
            }
          ]
        },
        "camera": {
          "description": "screens scenes only: how the device moves.",
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "still",
                "drift",
                "lean"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "caption": {
          "description": "A caption the scene draws under its own words, if any.",
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "weight",
        "arrival"
      ],
      "additionalProperties": false
    }
  }
}
