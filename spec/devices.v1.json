  "loop": {
    "size": [
      600,
      600
    ],
    "fps": 12,
    "max_bytes": 8388608,
    "_why": "A GIF for a README, a pull request or a chat that will not autoplay video: square because a README column and a chat bubble crop a square least, 600 points across because that is GitHub's README column at 1x, 12 frames a second because a GIF's size grows with every frame and a UI recording reads fine at 12. 8 MiB is GitHub's own image size limit for a pasted file (10 MB) with room."
  },
